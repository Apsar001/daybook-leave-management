# Backend runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:4200

# Database (PostgreSQL in Docker Compose)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=leave_user
DB_PASSWORD=leave_password
DB_NAME=leave_management

# JWT: replace both secrets in production with long random values
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Password hashing
BCRYPT_ROUNDS=12

# Login/refresh rate limit per minute
AUTH_RATE_LIMIT=5

# Frontend API URL (update frontend/src/environments/environment.ts if different)
NG_APP_API_URL=http://localhost:3000/api
